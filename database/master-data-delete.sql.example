-- PROPOSED: do not apply without separate current-target authorization.
-- Runtime is a trusted application role; per-user authorization/audit is in the service.
-- No owner membership, SECURITY DEFINER gateway, cascade, or stock/history DELETE.
BEGIN;
SET LOCAL lock_timeout='5s';
DO $check$
BEGIN
 IF current_database()<>'it_warehouse' THEN RAISE EXCEPTION 'Wrong database'; END IF;
 IF NOT EXISTS(SELECT 1 FROM pg_roles WHERE rolname='itwarehouse_backend' AND NOT rolsuper AND NOT rolcreatedb AND NOT rolcreaterole AND NOT rolreplication AND NOT rolbypassrls) THEN
  RAISE EXCEPTION 'Restricted runtime role required';
 END IF;
END
$check$;
GRANT DELETE ON TABLE public.inventory_assetcategory,
 public.inventory_manufacturer, public.inventory_productmodel,
 public.warehouse_warehouse, public.warehouse_storagelocation
 TO itwarehouse_backend;
-- Dependency existence query reads the FK only, not specification values.
GRANT SELECT (product_model_id) ON public.inventory_assetspecification
 TO itwarehouse_backend;
COMMIT;
